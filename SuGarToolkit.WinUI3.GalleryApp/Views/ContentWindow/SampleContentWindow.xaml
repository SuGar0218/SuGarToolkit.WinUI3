<?xml version="1.0" encoding="utf-8" ?>
<controls:ContentWindow
	x:Class="SuGarToolkit.WinUI3.GalleryApp.Views.SampleContentWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:SuGarToolkit.WinUI3.Controls.Windows"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:SuGarToolkit.WinUI3.GalleryApp.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<controls:ContentWindow.SystemBackdrop>
		<MicaBackdrop />
	</controls:ContentWindow.SystemBackdrop>

	<ScrollViewer>
		<Grid Margin="24" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Spacing="12">
				<TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="OuterBorderColor" />
				<Button
					Click="OnResetOuterBorderColorButtonClick"
					Content="Reset to auto"
					Style="{ThemeResource AccentButtonStyle}" />
				<ColorPicker ColorChanged="OnColorPickerColorChanged" />
			</StackPanel>

			<StackPanel Grid.Column="1" Spacing="12">
				<TextBox Header="Title" Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				<CheckBox Content="CanMinimize" IsChecked="{x:Bind CanMinimize, Mode=TwoWay}" />
				<CheckBox Content="CanMaximize" IsChecked="{x:Bind CanMaximize, Mode=TwoWay}" />
				<CheckBox Content="CanResize" IsChecked="{x:Bind CanResize, Mode=TwoWay}" />
				<CheckBox Content="ExtendsContentIntoTitleBar" IsChecked="{x:Bind ExtendsContentIntoTitleBar, Mode=TwoWay}" />
			</StackPanel>
		</Grid>
	</ScrollViewer>

</controls:ContentWindow>
