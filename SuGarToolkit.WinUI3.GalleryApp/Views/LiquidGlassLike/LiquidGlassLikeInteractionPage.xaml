<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="SuGarToolkit.WinUI3.GalleryApp.Views.LiquidGlassLike.LiquidGlassLikeInteractionPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:decorators="using:SuGarToolkit.WinUI3.Controls.Decorators"
	xmlns:helpers="using:SuGarToolkit.WinUI3.Helpers"
	xmlns:liquidglass="using:LiquidGlassWinUI"
	xmlns:local="using:SuGarToolkit.WinUI3.GalleryApp.Views.LiquidGlassLike"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	RequestedTheme="Dark"
	mc:Ignorable="d">

	<Page.Resources>
		<x:Double x:Key="ButtonMinSize">36</x:Double>
		<Style TargetType="Button">
			<Setter Property="MinWidth" Value="{StaticResource ButtonMinSize}" />
			<Setter Property="MinHeight" Value="{StaticResource ButtonMinSize}" />
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="MinHeight" Value="{StaticResource ButtonMinSize}" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style TargetType="FontIcon">
			<Setter Property="FontSize" Value="16" />
		</Style>

		<liquidglass:LiquidGlassBrush
			x:Key="LiquidGlassBrush"
			BlurAmount="4"
			Exposure="1.382"
			GlareAngle="45"
			GlareFactor="1"
			GlareHardness="0"
			RefDispersion="0"
			ShapeRadius="1"
			ShapeRoundness="2" />

		<StaticResource x:Key="ButtonBackground" ResourceKey="LiquidGlassBrush" />
		<StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="LiquidGlassBrush" />
		<StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="LiquidGlassBrush" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Image
			Grid.RowSpan="2"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Source="/Assets/OS 26 Liquid Glass Sample.jpg"
			Stretch="UniformToFill" />

		<Border
			Grid.RowSpan="2 "
			Background="Black"
			Opacity="0.382" />

		<Grid
			Grid.Row="0"
			Margin="16"
			ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="auto" />
			</Grid.ColumnDefinitions>
			<StackPanel
				Grid.Column="0"
				Orientation="Horizontal"
				Spacing="8">
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
						<FontIcon Glyph="&#xE72B;" />
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
						<FontIcon Glyph="&#xE72A;" />
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
						<FontIcon Glyph="&#xE72C;" />
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
			</StackPanel>
			<decorators:LiquidGlassLikeInteractionDecorator Grid.Column="1">
				<TextBox
					VerticalContentAlignment="Center"
					helpers:CapsuleShapeHelper.ShapeIntoCapsule="True"
					PlaceholderText="TextBox" />
			</decorators:LiquidGlassLikeInteractionDecorator>
			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal"
				Spacing="8">
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button
						MinHeight="{StaticResource ButtonMinSize}"
						Padding="8,0"
						helpers:CapsuleShapeHelper.ShapeIntoCapsule="True"
						Style="{ThemeResource AccentButtonStyle}">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<FontIcon VerticalAlignment="Center" Glyph="&#xE721;" />
							<TextBlock VerticalAlignment="Center" Text="Search" />
						</StackPanel>
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
						<FontIcon Glyph="&#xE72D;" />
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
				<decorators:LiquidGlassLikeInteractionDecorator>
					<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
						<FontIcon Glyph="&#xE712;" />
					</Button>
				</decorators:LiquidGlassLikeInteractionDecorator>
			</StackPanel>
		</Grid>

		<Grid
			x:Name="PART_DialGrid"
			Grid.Row="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			ColumnSpacing="12"
			RowSpacing="12">

			<Grid.Resources>
				<Style TargetType="Button">
					<Setter Property="Width" Value="64" />
					<Setter Property="Height" Value="64" />
					<Setter Property="FontSize" Value="32" />
				</Style>
			</Grid.Resources>

			<Grid.RowDefinitions>
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
			</Grid.RowDefinitions>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<decorators:LiquidGlassLikeInteractionDecorator Grid.Row="3" Grid.Column="0">
				<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
					<TextBlock Text="＊" />
				</Button>
			</decorators:LiquidGlassLikeInteractionDecorator>

			<decorators:LiquidGlassLikeInteractionDecorator Grid.Row="3" Grid.Column="1">
				<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
					<TextBlock Text="0" />
				</Button>
			</decorators:LiquidGlassLikeInteractionDecorator>

			<decorators:LiquidGlassLikeInteractionDecorator Grid.Row="3" Grid.Column="2">
				<Button helpers:CapsuleShapeHelper.ShapeIntoCapsule="True">
					<TextBlock Text="#" />
				</Button>
			</decorators:LiquidGlassLikeInteractionDecorator>
		</Grid>
	</Grid>

</Page>
