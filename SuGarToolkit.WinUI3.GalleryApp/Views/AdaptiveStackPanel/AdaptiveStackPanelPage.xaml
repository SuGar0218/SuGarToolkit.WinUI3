<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SuGarToolkit.WinUI3.GalleryApp.Views.AdaptiveStackPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layout="using:SuGarToolkit.WinUI3.Layout"
    xmlns:local="using:SuGarToolkit.WinUI3.GalleryApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <layout:AdaptiveStackPanel x:Name="PART_AdaptiveStackPanel">
        <ComboBox
            Header="PreferredOrientation"
            ItemsSource="{x:Bind local:AdaptiveStackPanelPage.Orientations}"
            SelectionChanged="ComboBox_SelectionChanged"/>
        <CheckBox Content="Lorem" />
        <CheckBox Content="Ipsum" />
        <CheckBox Content="Sit" />
        <CheckBox Content="Amet" />
    </layout:AdaptiveStackPanel>

</Page>
