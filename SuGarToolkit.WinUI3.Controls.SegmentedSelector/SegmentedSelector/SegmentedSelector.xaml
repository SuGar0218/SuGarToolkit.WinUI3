<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:community="using:CommunityToolkit.WinUI.Controls"
	xmlns:local="using:SuGarToolkit.WinUI3.Controls">

	<Style TargetType="local:SegmentedSelector">
		<Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<community:UniformGrid Rows="1" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:SegmentedSelector">
					<Grid
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">

						<!--  SliderBlock for display  -->
						<Canvas x:Name="PART_SliderBlockHost">
							<Border
								x:Name="PART_SliderBlock"
								Background="{ThemeResource ControlFillColorDefaultBrush}"
								BorderBrush="{ThemeResource ControlElevationBorderBrush}"
								BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
								CornerRadius="{TemplateBinding CornerRadius}">
								<!--  Pill-shaped selection indicator  -->
								<Rectangle
									Width="{ThemeResource ComboBoxItemPillHeight}"
									Height="{ThemeResource ComboBoxItemPillWidth}"
									HorizontalAlignment="Center"
									VerticalAlignment="Bottom"
									Fill="{ThemeResource AccentFillColorDefaultBrush}"
									RadiusX="2"
									RadiusY="2" />
							</Border>
						</Canvas>

						<ItemsPresenter x:Name="PART_ItemsHost" />

						<!--  SliderThumb for drag  -->
						<Canvas x:Name="PART_SliderThumbHost">
							<Thumb
								x:Name="PART_SliderThumb"
								Background="Transparent"
								BorderBrush="{x:Null}"
								BorderThickness="0"
								IsTabStop="False">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb">
										<Border
											Background="{TemplateBinding Background}"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="{TemplateBinding BorderThickness}"
											CornerRadius="{TemplateBinding CornerRadius}" />
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Canvas>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
