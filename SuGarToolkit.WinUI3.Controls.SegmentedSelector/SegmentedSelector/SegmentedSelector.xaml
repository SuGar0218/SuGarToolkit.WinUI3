<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:community="using:CommunityToolkit.WinUI.Controls"
	xmlns:local="using:SuGarToolkit.WinUI3.Controls">

	<Style TargetType="local:SegmentedSelector">
		<Setter Property="Background" Value="{ThemeResource ButtonBackgroundThemeBrush}" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<community:UniformGrid Rows="1" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:SegmentedSelector">
					<Grid
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<Canvas x:Name="PART_SliderHost">
							<Thumb
								x:Name="PART_SliderThumb"
								Background="{ThemeResource ControlFillColorDefaultBrush}"
								BorderBrush="{ThemeResource ControlElevationBorderBrush}"
								BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
								CornerRadius="{TemplateBinding CornerRadius}">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb">
										<Border
											Background="{TemplateBinding Background}"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="{TemplateBinding BorderThickness}"
											CornerRadius="{TemplateBinding CornerRadius}">
											<Rectangle
												Width="{ThemeResource ComboBoxItemPillHeight}"
												Height="{ThemeResource ComboBoxItemPillWidth}"
												HorizontalAlignment="Center"
												VerticalAlignment="Bottom"
												Fill="{ThemeResource AccentFillColorDefaultBrush}"
												RadiusX="2"
												RadiusY="2" />
										</Border>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Canvas>
						<ItemsPresenter x:Name="PART_ItemsHost" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
